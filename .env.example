# ClickHouse Configuration
CLICKHOUSE_HOST=nk8zetjq1w.us-east1.gcp.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=true
CLICKHOUSE_DATABASE=momentlab
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_clickhouse_password_here

# GCP & Vertex AI Project Settings
GOOGLE_GENAI_USE_VERTEXAI=true
GCP_PROJECT_ID=momentlab-504305
GOOGLE_CLOUD_PROJECT=momentlab-504305
GCP_LOCATION=us-central1

# Admin Credentials (Used for running migrations & schema setup)
CLICKHOUSE_ADMIN_USER=default
CLICKHOUSE_ADMIN_PASSWORD=your_clickhouse_admin_password_here

# Restricted Application Users (Created by clickhouse/00_init_users.sql)
CLICKHOUSE_WRITER_USER=momentlab_writer
CLICKHOUSE_WRITER_PASSWORD=momentlab_writer_secret_change_me

CLICKHOUSE_MCP_USER=momentlab_mcp_reader
CLICKHOUSE_MCP_PASSWORD=momentlab_mcp_reader_secret_change_me
FIRESTORE_EMULATOR_HOST=localhost:8080
